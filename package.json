{
  "name": "@juwel-development/react-observable-tools",
  "version": "2.2.0",
  "main": "dist/cjs/index.js",
  "module": "dist/es/index.js",
  "types": "dist/es/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/es/src/index.d.ts",
      "import": "./dist/es/index.js",
      "require": "./dist/cjs/index.js"
    },
    "./hooks": {
      "types": "./dist/es/src/hooks/index.d.ts",
      "import": "./dist/es/hooks.js",
      "require": "./dist/cjs/hooks.js"
    },
    "./event": {
      "types": "./dist/es/src/Event/index.d.ts",
      "import": "./dist/es/event.js",
      "require": "./dist/cjs/event.js"
    },
    "./operator": {
      "types": "./dist/es/src/Operator/index.d.ts",
      "import": "./dist/es/operator.js",
      "require": "./dist/cjs/operator.js"
    }
  },
  "private": false,
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rollup -c && tsc -p tsconfig.build.json --emitDeclarationOnly",
    "lint": "biome check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "start": "rollup -c -w",
    "release": "semantic-release",
    "prepare": "husky",
    "sandcastle": "sandcastle docker build-image && tsx .sandcastle/main.ts",
    "sandcastle:image": "sandcastle docker build-image"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.0.0",
    "tsyringe": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "reflect-metadata": {
      "optional": true
    },
    "tsyringe": {
      "optional": true
    }
  },
  "devDependencies": {
    "@ai-hero/sandcastle": "^0.12.0",
    "@biomejs/biome": "^2.5.8",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/git": "^11.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitest/coverage-v8": "^4.1.10",
    "esbuild": "^0.28.2",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "reflect-metadata": "^0.2.2",
    "rollup": "^4.62.4",
    "rollup-plugin-esbuild": "^6.2.1",
    "rxjs": "^7.8.1",
    "semantic-release": "^25.0.9",
    "tsx": "^4.23.11",
    "tsyringe": "^4.0.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10",
    "zod": "^4.4.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/juwel-development/LIB-react-observable-tools.git"
  },
  "keywords": [
    "react",
    "rxjs",
    "observable",
    "utility",
    "reactive"
  ]
}
